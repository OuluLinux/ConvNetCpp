<<?xml version="1.0" encoding="utf-8"?>
<Layout>
<Ctrl name="controls">
<ParentCtrl name="input_section">
<ParentCtrl name="imageUrlLabel" type="Label" sz="10000,20" />
<EditField name="imageUrlEdit" sz="10000,24" />
<Button name="loadButton" sz="10000,24" />
<ParentCtrl name="textLabel" type="Label" sz="10000,20" />
<EditField name="textPromptEdit" sz="10000,48" />
