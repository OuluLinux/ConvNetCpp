{
  "version": 1,
  "name": "basic1_scidoc",
  "annprj": "basic1.annprj",
  "annlay": "basic1.annlay",
  "mlui": "basic1.mlui",
  "crops_dir": "crops",
  "templates_dir": "templates",
  "images_dir": "images",
  "recognition_script": "basic1_recognition.py",
  "model_sets": {
    "pass1": "basic1_pass1.annmdl",
    "pass2": "basic1_pass2.annmdl"
  },
  "train_epochs": 50,
  "cv_template_groups": {
    "figure_token": {
      "slot_stems": [
        "figure_token_1",
        "figure_token_2",
        "figure_token_3",
        "figure_token_4",
        "figure_token_5"
      ],
      "templates_label_a_dir": "templates/label_a",
      "templates_label_b_dir": "templates/label_b",
      "label_a_crop": { "x": 4, "y": 6, "w": 22, "h": 22 },
      "label_b_crop": { "x": 4, "y": 28, "w": 22, "h": 22 },
      "label_a_display": "token_a",
      "label_b_display": "token_b",
      "present_display": "is_present",
      "match_method": "TM_CCOEFF_NORMED",
      "match_threshold": 0.65,
      "zoom_range": [0.7, 1.3],
      "zoom_steps": 7,
      "rotation_slots": [],
      "slot_rotation_deg": {
        "figure_token_1": 0,
        "figure_token_2": 0,
        "figure_token_3": 0,
        "figure_token_4": 0,
        "figure_token_5": 0
      },
      "rotation_range_deg": [-4, 4],
      "rotation_steps": 9
    },
    "header_token": {
      "slot_stems": [
        "header_token_1",
        "header_token_2"
      ],
      "templates_label_a_dir": "templates/label_a",
      "templates_label_b_dir": "templates/label_b",
      "label_a_crop": { "x": 4, "y": 6, "w": 22, "h": 22 },
      "label_b_crop": { "x": 4, "y": 28, "w": 22, "h": 22 },
      "label_a_display": "token_a",
      "label_b_display": "token_b",
      "present_display": "is_present",
      "match_method": "TM_CCOEFF_NORMED",
      "match_threshold": 0.65,
      "zoom_range": [0.7, 1.3],
      "zoom_steps": 7,
      "rotation_slots": [
        "header_token_1",
        "header_token_2"
      ],
      "slot_rotation_deg": {
        "header_token_1": -4,
        "header_token_2": 4
      },
      "rotation_range_deg": [-4, 4],
      "rotation_steps": 9
    }
  }
}
